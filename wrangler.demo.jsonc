// PUBLIC STATIC DEMO hosting ONLY (Cloudflare Workers static assets: no Worker script, no bindings, no secrets).
// Deploy:  npm run build:demo && npx wrangler deploy -c wrangler.demo.jsonc
// Never use the operational wrangler.toml for the demo, and never add "main", bindings or vars here.
{
  "name": "lightyield-demo",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": { "directory": "./dist-demo", "not_found_handling": "404-page" }
}
